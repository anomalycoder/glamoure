# ═════════════════════════════════════════════════════════════════════════════
# GLAMOURÉ ENTERPRISE SALON MANAGEMENT PLATFORM
# Environment Variable Configuration Template
# Copy this file to .env.local for local development or configure in CI/CD pipeline
# ═════════════════════════════════════════════════════════════════════════════

# Application Environment
VITE_APP_NAME=Glamouré
VITE_APP_ENV=production
VITE_APP_URL=https://glamoure.luxury
VITE_API_BASE_URL=https://api.glamoure.luxury

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/glamoure_prod
SUPABASE_URL=https://[PROJECT-ID].supabase.co
SUPABASE_ANON_KEY=[SUPABASE_ANON_PUBLIC_KEY]
SUPABASE_SERVICE_ROLE_KEY=[SUPABASE_SERVICE_ROLE_SECRET_KEY]

# Authentication & Session Security
JWT_SECRET=[GENERATE_SECURE_64_CHAR_RANDOM_SECRET]
JWT_EXPIRATION_HOURS=24
SESSION_COOKIE_NAME=glamoure_session_v1
AUTH_RATE_LIMIT_PER_MINUTE=15
GOOGLE_CLIENT_ID=[GOOGLE_OAUTH_CLIENT_ID]
GOOGLE_CLIENT_SECRET=[GOOGLE_OAUTH_CLIENT_SECRET]

# Payment Gateways (Razorpay & Stripe)
# Active Primary Gateway: razorpay (default for INR) | stripe (default for USD/EUR)
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_[KEY_ID]
RAZORPAY_KEY_SECRET=[RAZORPAY_SECRET]
RAZORPAY_WEBHOOK_SECRET=[RAZORPAY_WEBHOOK_SECRET]
STRIPE_PUBLISHABLE_KEY=pk_live_[STRIPE_KEY]
STRIPE_SECRET_KEY=sk_live_[STRIPE_SECRET]
STRIPE_WEBHOOK_SECRET=whsec_[STRIPE_WEBHOOK_SECRET]

# Transactional Communications (Email / SMS / WhatsApp)
EMAIL_PROVIDER=resend # Options: resend | sendgrid
RESEND_API_KEY=re_[RESEND_API_KEY]
FROM_EMAIL_ADDRESS=concierge@glamoure.luxury
FROM_EMAIL_NAME=Glamouré Sanctuary Concierge

# SMS & WhatsApp Notifications (Twilio / Meta Graph)
TWILIO_ACCOUNT_SID=AC[TWILIO_SID]
TWILIO_AUTH_TOKEN=[TWILIO_AUTH_TOKEN]
TWILIO_PHONE_NUMBER=+1234567890
WHATSAPP_BUSINESS_ACCOUNT_ID=[WHATSAPP_ACCOUNT_ID]
WHATSAPP_ACCESS_TOKEN=[WHATSAPP_GRAPH_TOKEN]

# Cloud Media & File Storage
STORAGE_PROVIDER=supabase # Options: supabase | s3
STORAGE_BUCKET_NAME=glamoure-media-prod
AWS_ACCESS_KEY_ID=[AWS_ACCESS_KEY_ID]
AWS_SECRET_ACCESS_KEY=[AWS_SECRET_ACCESS_KEY]
AWS_REGION=ap-south-1

# AI & Machine Learning Inference Engine
ML_INFERENCE_ENGINE=internal_pipeline # Options: internal_pipeline | external_python_api
ML_SERVICE_URL=https://ml.glamoure.luxury
ML_MODEL_VERSION=2.1.0
ENABLE_REALTIME_INFERENCE=true
HARD_CONSTRAINT_ENFORCEMENT=strict
